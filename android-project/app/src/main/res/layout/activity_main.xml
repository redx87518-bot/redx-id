<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/bg_dark">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_id_card"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REDX ID CARD"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/gold"
        android:letterSpacing="0.12"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generator"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="For Educational Purposes Only"
        android:textSize="12sp"
        android:textColor="@color/warning"
        android:layout_marginBottom="40dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPakistan"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🇵🇰  Pakistan CNIC"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/green_pk"
        android:layout_marginBottom="16dp"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNigeria"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🇳🇬  Nigeria NIN"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/green_ng"
        app:cornerRadius="12dp" />

</LinearLayout>
